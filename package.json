{
  "name": "orkest-ui",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "pnpm --filter @orkest/ui build",
    "test": "pnpm --filter @orkest/ui test",
    "test:coverage": "pnpm --filter @orkest/ui test:coverage",
    "test:watch": "pnpm --filter @orkest/ui test:watch",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:docs-samples": "node scripts/check-docs-samples.mjs",
    "check:package": "pnpm --filter @orkest/ui build && pnpm check:published",
    "check:published": "publint packages/ui && attw --pack packages/ui --profile esm-only --exclude-entrypoints ./style.css",
    "check:audit": "pnpm audit --prod --audit-level=high",
    "smoke:package": "pnpm --filter @orkest/ui build && node scripts/smoke-package.mjs",
    "e2e:build": "pnpm --filter @orkest/ui build && pnpm --filter @orkest/docs exec next build",
    "test:e2e": "playwright test tests/smoke.spec.ts",
    "test:visual": "playwright test tests/visual.spec.ts",
    "test:visual:update": "playwright test tests/visual.spec.ts --update-snapshots",
    "test:visual:docker": "node scripts/visual-docker.mjs",
    "test:visual:docker:update": "node scripts/visual-docker.mjs --update-snapshots",
    "docs:dev": "pnpm --filter @orkest/docs dev",
    "docs:build": "pnpm --filter @orkest/docs build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.14.0",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "publint": "^0.3.25",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0"
  }
}
