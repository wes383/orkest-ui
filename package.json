{
  "name": "orkest-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @orkest/ui build",
    "test": "pnpm --filter @orkest/ui test",
    "test:watch": "pnpm --filter @orkest/ui test:watch",
    "typecheck": "pnpm -r --if-present typecheck",
    "storybook": "pnpm --filter @orkest/docs storybook",
    "build:storybook": "pnpm --filter @orkest/docs build-storybook"
  }
}
