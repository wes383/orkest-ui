{
  "name": "orkest-ui",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "pnpm --filter @orkest/ui build",
    "test": "pnpm --filter @orkest/ui test",
    "test:watch": "pnpm --filter @orkest/ui test:watch",
    "typecheck": "pnpm -r --if-present typecheck",
    "docs:dev": "pnpm --filter @orkest/docs dev",
    "docs:build": "pnpm --filter @orkest/docs build",
    "playground:dev": "pnpm --filter @orkest/playground dev",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3"
  }
}
